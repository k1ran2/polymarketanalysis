# Copy this file to `.env` and fill in the values you want. Nothing here is
# required to run the dashboard -- every setting has a safe default (email
# alerts just get logged to the console instead of sent).

# --- Insider email alerts (app/alerts.py) ---
# Leave SMTP_HOST blank to just log alerts instead of emailing them.
# Gmail example: host=smtp.gmail.com, port=587, an "app password" (not your
# normal password) as SMTP_PASSWORD. Any SMTP relay (Resend, SendGrid, your
# own mail server, etc.) works the same way.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- Background poller (app/poller.py) ---
# Re-analyzes tracked markets on a timer so insider alerts can fire even when
# nobody has the dashboard open. Only runs while the backend process is up.
POLLER_ENABLED=true
POLLER_INTERVAL_SECONDS=300
